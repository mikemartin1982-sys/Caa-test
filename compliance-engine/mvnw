# Maven Start Up shell script (wrapper edition)
#
# Usage: ./mvnw clean compile
#
# On first run this downloads the Maven distribution pinned in
# .mvn/wrapper/maven-wrapper.properties, then delegates to it -- no
# separately-installed Maven required.

set -e

if [ -z "$JAVA_HOME" ]; then
  echo "Error: JAVA_HOME not set." >&2
  exit 1
fi

if [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "Error: JAVA_HOME is set to \"$JAVA_HOME\" but \"$JAVA_HOME/bin/java\" is not executable." >&2
  exit 1
fi

BASEDIR=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$BASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper..."
  WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "Error: neither curl nor wget is available to download maven-wrapper.jar." >&2
    exit 1
  fi
fi

exec "$JAVA_HOME/bin/java" \
  -Dmaven.multiModuleProjectDirectory="$BASEDIR" \
  -classpath "$WRAPPER_JAR" \
  "$WRAPPER_LAUNCHER" "$@"

# CAA Desk — server environment (never commit the real values)

# Compliance Engine base URL. Same VPS: the local address, not the public api. host.
COMPLIANCE_ENGINE_URL=http://127.0.0.1:8080

# Postgres for the Desk's own data (a third database/login beyond the two in the VPS plan).
DATABASE_URL=postgres://caa_desk_user:CHANGE-ME@127.0.0.1:5432/caa_desk

# Session signing secret: generate with `openssl rand -base64 32`.
# REQUIRED in production, otherwise sessions die on every restart.
BETTER_AUTH_SECRET=

# Public URL of the Desk (used for the origin check on sign-in).
BETTER_AUTH_URL=https://desk.caatest.tech

# Optional: comma-separated engine usernames allowed into the Desk.
# Unset = any valid engine staff login gets in.
CAA_DESK_ALLOWED_USERS=

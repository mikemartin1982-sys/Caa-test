APP_NAME="Compliance Assurance Associates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel's OWN database -- portal auth/sessions/cache/queue, plus the
# mailbox CRM tables. Business domain data (Sessions, Enrollments,
# Clients, Certifications) lives in the Compliance Engine's own
# Postgres database, never queried directly from here -- always
# through COMPLIANCE_ENGINE_BASE_URL below.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=caa_portal
DB_USERNAME=caa_portal_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Internal API contract -- see api-contract/openapi.yaml. Note the exact
# variable name: config/services.php reads COMPLIANCE_ENGINE_BASE_URL,
# not COMPLIANCE_ENGINE_URL -- using the wrong name silently falls back
# to this default instead of erroring.
COMPLIANCE_ENGINE_BASE_URL=http://127.0.0.1:8080/api/v1
COMPLIANCE_ENGINE_TIMEOUT=10
# Dedicated SERVICE ACCOUNT StaffUser -- not any individual staff login.
COMPLIANCE_ENGINE_USERNAME=
COMPLIANCE_ENGINE_PASSWORD=

# QuickBooks Online (OAuth 2.0) -- never in code, never in chat.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://127.0.0.1:8000/admin/qbo/callback
QBO_ENVIRONMENT=SANDBOX

# Client Mailbox CRM (Microsoft Graph). Enable only after the mailbox
# migrations have run and Microsoft app registration is configured.
MAILBOX_ENABLED=false
GRAPH_AUTH_MODE=application
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=client@compliance-assurance.com
GRAPH_INBOX_FOLDER=inbox
# Only used when GRAPH_AUTH_MODE=delegated. Register this exact path
# under the Microsoft app's Web redirect URIs:
# https://YOUR-PORTAL-DOMAIN/admin/mailbox/microsoft/callback
GRAPH_REDIRECT_URI=

APP_NAME="Compliance Assurance Associates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Laravel's OWN database -- portal auth/sessions/cache/queue only.
# Business domain data (Sessions, Enrollments, Clients, Certifications)
# lives in the Compliance Engine's Postgres, never queried directly from
# here -- always through COMPLIANCE_ENGINE_BASE_URL below (Section 2).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=caa_portal
DB_USERNAME=root
DB_PASSWORD=

# Internal API contract -- see api-contract/openapi.yaml
COMPLIANCE_ENGINE_BASE_URL=http://compliance-engine.internal:8080/api/v1
COMPLIANCE_ENGINE_TIMEOUT=10

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Enable only after mailbox migrations and Microsoft configuration are ready.
MAILBOX_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=client@compliance-assurance.com
GRAPH_INBOX_FOLDER=inbox
